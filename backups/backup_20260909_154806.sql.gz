    enrolled_on date NOT NULL,
    is_current boolean NOT NULL,
    school_id bigint NOT NULL,
    session_id bigint NOT NULL,
    school_class_id bigint NOT NULL,
    student_id bigint NOT NULL
);


--
-- Name: students_classenrollment_id_seq; Type: SEQUENCE; Schema: public; Owner: -
--

ALTER TABLE public.students_classenrollment ALTER COLUMN id ADD GENERATED BY DEFAULT AS IDENTITY (
    SEQUENCE NAME public.students_classenrollment_id_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1
);


--
-- Name: students_schoolclass; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.students_schoolclass (
    id bigint NOT NULL,
    name character varying(100) NOT NULL,
    level character varying(100) NOT NULL,
    is_active boolean NOT NULL,
    school_id bigint NOT NULL
);


--
-- Name: students_schoolclass_id_seq; Type: SEQUENCE; Schema: public; Owner: -
--

ALTER TABLE public.students_schoolclass ALTER COLUMN id ADD GENERATED BY DEFAULT AS IDENTITY (
    SEQUENCE NAME public.students_schoolclass_id_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1
);


--
-- Name: students_student; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.students_student (
    id bigint NOT NULL,
    admission_number character varying(50) NOT NULL,
    date_of_birth date NOT NULL,
    gender character varying(10) NOT NULL,
    admission_date date NOT NULL,
    status character varying(20) NOT NULL,
    school_id bigint NOT NULL,
    user_id bigint NOT NULL,
    updated_at timestamp with time zone NOT NULL,
    passport character varying(100) NOT NULL,
    local_government_area character varying(100) NOT NULL,
    state_of_origin character varying(100) NOT NULL,
    registration_paid_term_id bigint,
    student_type character varying(20) NOT NULL
);


--
-- Name: students_student_id_seq; Type: SEQUENCE; Schema: public; Owner: -
--

ALTER TABLE public.students_student ALTER COLUMN id ADD GENERATED BY DEFAULT AS IDENTITY (
    SEQUENCE NAME public.students_student_id_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1
);


--
-- Name: students_studentguardianlink; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.students_studentguardianlink (
    id bigint NOT NULL,
    relationship character varying(20) NOT NULL,
    is_primary_contact boolean NOT NULL,
    guardian_id bigint NOT NULL,
    school_id bigint NOT NULL,
    student_id bigint NOT NULL,
    other_phones jsonb NOT NULL,
    address character varying(255) NOT NULL,
    authorized_pickup_person character varying(100) NOT NULL,
    occupation character varying(100) NOT NULL
);


--
-- Name: students_studentguardianlink_id_seq; Type: SEQUENCE; Schema: public; Owner: -
--

ALTER TABLE public.students_studentguardianlink ALTER COLUMN id ADD GENERATED BY DEFAULT AS IDENTITY (
    SEQUENCE NAME public.students_studentguardianlink_id_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1
);


