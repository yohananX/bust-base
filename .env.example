# Django
SECRET_KEY=change-me-to-a-real-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Database (docker-compose db service)
DATABASE_URL=postgres://ghss_user:ghss_pass@db:5432/ghss_db
POSTGRES_DB=ghss_db
POSTGRES_USER=ghss_user
POSTGRES_PASSWORD=ghss_pass

# Payments
PAYSTACK_SECRET_KEY=sk_test_placeholder
PAYSTACK_PUBLIC_KEY=pk_test_placeholder

# Email (Brevo transactional API)
EMAIL_BACKEND=notifications.brevo_backend.BrevoEmailBackend
BREVO_API_KEY=xkeysib-placeholder
DEFAULT_FROM_EMAIL=noreply@your-verified-domain.com

# Storage
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# Caching
REDIS_URL=redis://127.0.0.1:6379/0

# Error monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Production hardening (set True/values in production)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_BROWSER_XSS_FILTER=True
# SECURE_REFERRER_POLICY=same-origin
# CSRF_COOKIE_SAMESITE=Lax
# SESSION_COOKIE_SAMESITE=Lax
# SECURE_CROSS_ORIGIN_OPENER_POLICY=same-origin