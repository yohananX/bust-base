# ┌─────────────────────────────────────────────────────────────────────────────┐
# │                        PRODUCTION ENVIRONMENT VARIABLES                     │
# │                                                                             │
# │  Copy this file to .env on your production server and fill in real values. │
# │  NEVER commit .env to version control.                                     │
# └─────────────────────────────────────────────────────────────────────────────┘

# ─── Django Core ──────────────────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-generated-secret-key

# Production MUST use False
DEBUG=False

# Your real domain(s), e.g. app.yourschool.com, www.yourschool.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Same domain list but with scheme, e.g. https://app.yourschool.com
CSRF_TRUSTED_ORIGINS=https://app.yourschool.com

# ─── Database ─────────────────────────────────────────────────────────────────
# Format: postgres://USER:PASSWORD@HOST:PORT/DB_NAME
# For docker-compose: DATABASE_URL=postgres://ghss_user:ghss_pass@db:5432/ghss_db
# For external DB:    DATABASE_URL=postgres://user:pass@host.example.com:5432/bustbase
DATABASE_URL=postgres://ghss_user:ghss_pass@db:5432/ghss_db

# ─── Payments ─────────────────────────────────────────────────────────────────
# Paystack live keys from https://dashboard.paystack.com/#/settings/developers
# Live keys start with sk_live_ / pk_live_
PAYSTACK_SECRET_KEY=sk_live_
PAYSTACK_PUBLIC_KEY=pk_live_
PAYSTACK_BASE_URL=https://api.paystack.co
DEFAULT_CURRENCY=NGN

# ─── Email ────────────────────────────────────────────────────────────────────
# Option A: Brevo transactional email (recommended)
EMAIL_BACKEND=notifications.brevo_backend.BrevoEmailBackend
BREVO_API_KEY=xkeysib-
DEFAULT_FROM_EMAIL=noreply@your-verified-domain.com

# Option B: SMTP (alternative)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# ─── Storage ──────────────────────────────────────────────────────────────────
# Set to True to use S3 for media uploads
USE_S3=False

# AWS credentials from https://console.aws.amazon.com/iam/
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# ─── Caching ──────────────────────────────────────────────────────────────────
# Redis URL for caching and Django-Q2
# For docker-compose: REDIS_URL=redis://redis:6379/0
# For external Redis:  REDIS_URL=redis://redis.example.com:6379/0
REDIS_URL=redis://redis:6379/0

# ─── Error Monitoring ─────────────────────────────────────────────────────────
# Sentry DSN from https://sentry.io/settings/your-org/projects/your-project/keys/
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ─── Logging ──────────────────────────────────────────────────────────────────
DJANGO_LOG_LEVEL=INFO

# ─── Production Security ──────────────────────────────────────────────────────
# HTTPS enforcement
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Cookie security
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True

# Browser security headers
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
SECURE_REFERRER_POLICY=same-origin
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SAMESITE=Lax
SECURE_CROSS_ORIGIN_OPENER_POLICY=same-origin
